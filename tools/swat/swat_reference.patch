diff --git a/src/ls_dump_module.f90 b/src/ls_dump_module.f90
new file mode 100644
index 0000000..d3ec31b
--- /dev/null
+++ b/src/ls_dump_module.f90
@@ -0,0 +1,104 @@
+      module ls_dump_module
+!!    landschaft parity harness: binary daily dump of SWAT+ states.
+!!    Active only when the environment variable SWAT_DUMP names a file.
+!!    Record: int32 tag, yrc, day, id, n; then n real32 values.
+      use iso_fortran_env, only : int32
+      implicit none
+      integer :: ls_dump_unit = -1
+      logical :: ls_dump_on = .false.
+      contains
+
+      subroutine ls_dump_open
+        character(len=1024) :: path
+        integer :: n, st
+        call get_environment_variable ("SWAT_DUMP", path, n, st)
+        if (st == 0 .and. n > 0) then
+          open (newunit=ls_dump_unit, file=path(1:n), access="stream", form="unformatted", status="replace")
+          ls_dump_on = .true.
+        end if
+      end subroutine ls_dump_open
+
+      subroutine ls_dump (tag, id, vals)
+        use time_module
+        integer, intent(in) :: tag, id
+        real, dimension(:), intent(in) :: vals
+        if (.not. ls_dump_on) return
+        write (ls_dump_unit) int(tag,int32), int(time%yrc,int32), int(time%day,int32), int(id,int32), &
+                             int(size(vals),int32), vals
+      end subroutine ls_dump
+
+      subroutine ls_dump_hru (j)
+        use output_landscape_module, only : hwb_d, hnb_d, hls_d, hpw_d
+        integer, intent(in) :: j
+        if (.not. ls_dump_on) return
+        call ls_dump (10, j, transfer(hwb_d(j), [0.]))
+        call ls_dump (11, j, transfer(hnb_d(j), [0.]))
+        call ls_dump (12, j, transfer(hls_d(j), [0.]))
+        call ls_dump (13, j, transfer(hpw_d(j), [0.]))
+      end subroutine ls_dump_hru
+
+      subroutine ls_dump_aqu (i)
+        use aquifer_module, only : aqu_d
+        integer, intent(in) :: i
+        if (.not. ls_dump_on) return
+        call ls_dump (20, i, transfer(aqu_d(i), [0.]))
+      end subroutine ls_dump_aqu
+
+      subroutine ls_dump_cha (i)
+        use sd_channel_module, only : chsd_d
+        integer, intent(in) :: i
+        if (.not. ls_dump_on) return
+        call ls_dump (30, i, transfer(chsd_d(i), [0.]))
+      end subroutine ls_dump_cha
+
+      subroutine ls_dump_obj (i)
+        use hydrograph_module, only : ob
+        integer, intent(in) :: i
+        if (.not. ls_dump_on) return
+        call ls_dump (40, i, transfer(ob(i)%hd, [0.]))
+      end subroutine ls_dump_obj
+
+      subroutine ls_dump_hin (i)
+        use hydrograph_module, only : ob
+        integer, intent(in) :: i
+        if (.not. ls_dump_on) return
+        call ls_dump (41, i, [transfer(ob(i)%hin, [0.]), transfer(ob(i)%hin_sur, [0.]),        &
+          transfer(ob(i)%hin_lat, [0.]), transfer(ob(i)%hin_til, [0.]), transfer(ob(i)%hin_aqu, [0.])])
+      end subroutine ls_dump_hin
+
+      subroutine ls_dump_init
+!!      the state at the start of the daily loop: soil layers (tag 3, id = 100 hru + layer),
+!!      hru values (tag 4) and plants (tag 5, id = 100 hru + plant)
+        use hydrograph_module, only : sp_ob, ru_elem
+        use soil_module, only : soil
+        use hru_module, only : hru, cn2, wfsh, cvm_com
+        use plant_module, only : pcom
+        use organic_mineral_mass_module, only : pl_mass
+        integer :: j, ly, ipl
+        if (.not. ls_dump_on) return
+        do j = 1, sp_ob%hru
+          do ly = 1, soil(j)%nly
+            call ls_dump (3, 100 * j + ly, transfer(soil(j)%phys(ly), [0.]))
+          end do
+          call ls_dump (4, j, [soil(j)%sw, soil(j)%sumfc, soil(j)%sumul, soil(j)%avpor, soil(j)%avbd,          &
+            soil(j)%sumwp, cn2(j), hru(j)%lumv%usle_ls, hru(j)%lumv%usle_p, wfsh(j), hru(j)%topo%slope,         &
+            hru(j)%hyd%perco_lim, cvm_com(j), pcom(j)%rsd_covfac, real(soil(j)%nly), real(pcom(j)%npl),       &
+            hru(j)%sno_mm, hru(j)%snocov1, hru(j)%snocov2, hru(j)%hyd%pet_co, hru(j)%topo%lat_len,             &
+            pl_mass(j)%rsd_tot%m, pl_mass(j)%rsd_tot%n, pcom(j)%laimx_sum])
+          do ipl = 1, pcom(j)%npl
+            call ls_dump (5, 100 * j + ipl, [pcom(j)%plcur(ipl)%phumat, pcom(j)%plcur(ipl)%phuacc,             &
+              real(pcom(j)%plcur(ipl)%curyr_mat), pcom(j)%plcur(ipl)%phumat_p, pcom(j)%plcur(ipl)%phuacc_p,    &
+              pcom(j)%plg(ipl)%lai, pcom(j)%plg(ipl)%cht, pcom(j)%plg(ipl)%laimxfr, pcom(j)%plg(ipl)%root_dep, &
+              pl_mass(j)%tot(ipl)%m, pl_mass(j)%tot(ipl)%n, pl_mass(j)%tot(ipl)%p, pl_mass(j)%root(ipl)%m,     &
+              pl_mass(j)%ab_gr(ipl)%m, pl_mass(j)%leaf(ipl)%m, pl_mass(j)%stem(ipl)%m, pl_mass(j)%seed(ipl)%m,  &
+              pcom(j)%plm(ipl)%n_fr, pcom(j)%plm(ipl)%p_fr, pcom(j)%plcur(ipl)%lai_pot])
+          end do
+        end do
+        if (allocated(ru_elem)) then
+          do j = 1, size(ru_elem)
+            call ls_dump (6, j, transfer(ru_elem(j)%dr, [0.]))
+          end do
+        end if
+      end subroutine ls_dump_init
+
+      end module ls_dump_module
